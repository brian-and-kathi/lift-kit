<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/exercise_card_background"
        android:foreground="@drawable/exercise_card_border"
        android:padding="0dp"
        android:clipChildren="true"
        android:clipToOutline="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/titleContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="#5B2C6F"
            android:paddingTop="0dp"
            android:paddingLeft="0dp"
            android:paddingRight="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#F9F72E"
                android:gravity="center"
                android:includeFontPadding="false"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/helpIcon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:text="Bench Press" />

            <ImageView
                android:id="@+id/helpIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_exercise_mark"
                android:padding="6dp"
                android:contentDescription="Search exercise online"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/statsRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/restPanel">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/weightLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#BDBDBD"
                    android:textSize="12sp"
                    tools:text="Weight" />

                <TextView
                    android:id="@+id/weightValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="#FFFF00"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    tools:text="45" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/repsLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#BDBDBD"
                    android:textSize="12sp"
                    tools:text="Reps" />

                <TextView
                    android:id="@+id/repsValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="#00FFFF"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    tools:text="8" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/setsLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#BDBDBD"
                    android:textSize="12sp"
                    tools:text="Sets" />

                <TextView
                    android:id="@+id/setsValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="#00FF00"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    tools:text="4" />
            </LinearLayout>
        </LinearLayout>

        <com.gymbuddy.ProgressPieChart
            android:id="@+id/progressPieChart"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toTopOf="@+id/difficultyBlock"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/statsRow" />

        <LinearLayout
            android:id="@+id/difficultyBlock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@+id/notesText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.google.android.material.slider.Slider
                android:id="@+id/difficultySlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="Difficulty"
                android:stepSize="1.0"
                android:value="1.0"
                android:valueFrom="0.0"
                android:valueTo="2.0"
                app:haloRadius="20dp"
                app:thumbRadius="12dp"
                app:trackHeight="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/labelEasy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:text="Easy"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/labelGood"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Good"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/labelHard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="Hard"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/notesText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:gravity="center_horizontal"
            android:textAlignment="center"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="Notes: Keep elbows in" />


        <!-- Compact rest band. Must stay wrap_content under the title so weight,
             reps, sets, and notes stay on screen. Do not pin this to the bottom. -->
        <LinearLayout
            android:id="@+id/restPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_rest_band"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/titleContainer"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.gymbuddy.ProgressPieChart
                    android:id="@+id/restPieChart"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:contentDescription="Rest timer" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/restNextText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="#9A9AA2"
                        android:textSize="14sp"
                        tools:text="Next · Incline Press · 45 lb" />

                    <TextView
                        android:id="@+id/restSourceText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#6E6E76"
                        android:textSize="12sp"
                        tools:text="Hard · 1:00" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:id="@+id/restButtons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/restMinusBtn"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        app:backgroundTint="#1B1B1D"
                        android:minHeight="40dp"
                        android:text="−15s"
                        android:textAllCaps="false"
                        android:textColor="#ECECEC"
                        android:textSize="15sp"
                        app:cornerRadius="12dp"
                        app:insetTop="0dp"
                        app:insetBottom="0dp"
                        app:strokeColor="#2C2C30"
                        app:strokeWidth="1dp" />

                    <Button
                        android:id="@+id/restPlusBtn"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        app:backgroundTint="#1B1B1D"
                        android:minHeight="40dp"
                        android:text="+15s"
                        android:textAllCaps="false"
                        android:textColor="#ECECEC"
                        android:textSize="15sp"
                        app:cornerRadius="12dp"
                        app:insetTop="0dp"
                        app:insetBottom="0dp"
                        app:strokeColor="#2C2C30"
                        app:strokeWidth="1dp" />

                    <Button
                        android:id="@+id/restSkipBtn"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1.15"
                        app:backgroundTint="#1B1B1D"
                        android:minHeight="40dp"
                        android:text="Skip"
                        android:textAllCaps="false"
                        android:textColor="#F9F72E"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:insetTop="0dp"
                        app:insetBottom="0dp"
                        app:strokeColor="#5A5230"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/restGoText"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="Go"
                    android:textColor="#F9F72E"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/fullScreenNotesText"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/item_border"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Keep elbows in" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
